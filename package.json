{
  "name": "dp-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.17.0 <21",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "demo:setup": "node scripts/demo.mjs setup",
    "demo:start": "node scripts/demo.mjs start",
    "demo:stop": "node scripts/demo.mjs stop",
    "demo:reset": "node scripts/demo.mjs reset",
    "demo:status": "node scripts/demo.mjs status",
    "demo:data:verify": "node scripts/demo.mjs data-verify",
    "demo:access:grant": "node scripts/demo-access.mjs grant",
    "demo:access:status": "node scripts/demo-access.mjs status",
    "demo:access:revoke": "node scripts/demo-access.mjs revoke",
    "demo:smoke:essential": "node scripts/mvp-essential-smoke.mjs",
    "demo:smoke:p1": "node scripts/full-delivery-p1-smoke.mjs",
    "demo:verify": "node scripts/demo.mjs verify",
    "demo:ready": "node scripts/demo.mjs ready",
    "demo:rehearse": "node scripts/demo.mjs rehearse",
    "presentation:capture": "node scripts/presentation-capture.mjs",
    "presentation:build": "node scripts/presentation-build.mjs",
    "presentation:verify": "node scripts/presentation-verify.mjs",
    "presentation:pdf": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/presentation-export-pdf.ps1",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/demo-readiness.test.mjs scripts/presentation.test.mjs",
    "test:coverage": "turbo run test:coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm prisma:validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "prisma:generate": "pnpm --filter @dp-system/api prisma:generate",
    "prisma:validate": "pnpm --filter @dp-system/api prisma:validate",
    "prisma:migrate:deploy": "pnpm --filter @dp-system/api prisma:migrate:deploy",
    "prisma:seed": "pnpm --filter @dp-system/api prisma:seed",
    "prisma:seed:demo": "pnpm --filter @dp-system/api prisma:seed:demo"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "jszip": "3.10.1",
    "lint-staged": "^15.3.0",
    "playwright-core": "1.62.1",
    "pptxgenjs": "4.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
